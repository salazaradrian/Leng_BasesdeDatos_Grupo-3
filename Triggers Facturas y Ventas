CREATE TABLE auditoria_facturas (
    id_auditoria NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY PRIMARY KEY,
    id_factura   NUMBER,
    accion       VARCHAR2(20),
    usuario      VARCHAR2(30),
    fecha_accion DATE,
    datos_antiguos VARCHAR2(500)
);

CREATE OR REPLACE TRIGGER trg_auditoria_factura
AFTER INSERT OR UPDATE OR DELETE ON factura
FOR EACH ROW
BEGIN
    IF INSERTING THEN
        INSERT INTO auditoria_facturas (id_factura, accion, usuario, fecha_accion)
        VALUES (:NEW.id_factura, 'INSERT', USER, SYSDATE);

    ELSIF UPDATING THEN
        INSERT INTO auditoria_facturas (id_factura, accion, usuario, fecha_accion, datos_antiguos)
        VALUES (:OLD.id_factura, 'UPDATE', USER, SYSDATE,
                'Subtotal anterior: ' || :OLD.subtotal || ', Impuesto anterior: ' || :OLD.impuesto);

    ELSIF DELETING THEN
        INSERT INTO auditoria_facturas (id_factura, accion, usuario, fecha_accion, datos_antiguos)
        VALUES (:OLD.id_factura, 'DELETE', USER, SYSDATE,
                'Subtotal: ' || :OLD.subtotal || ', Impuesto: ' || :OLD.impuesto);
    END IF;
END;
/


